{
  "expo": {
    "name": "Grocery Saver",
    "slug": "florida-grocery-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grocerysaver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shopsmarter.grocerysaver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F8A4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shopsmarter.grocerysaver"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Grocery Saver",
      "shortName": "Grocery Saver",
      "themeColor": "#1F8A4C",
      "backgroundColor": "#F6F7F4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1F8A4C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Florida Grocery Saver uses your location to find the nearest stores and estimate driving cost."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
